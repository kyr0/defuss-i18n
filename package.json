{
  "name": "defuss-i18n",
  "version": "0.1.0",
  "description": "HTML-authored localization with component-owned DOM morphing, attribute translations and native Intl formatting.",
  "type": "module",
  "license": "MIT",
  "author": "Aron Homberg <info@aron-homberg.de>",
  "keywords": [
    "defuss",
    "i18n",
    "html",
    "morph",
    "localization",
    "typescript",
    "shadcn"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.js"
      }
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "default": "./dist/all.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/all.js",
    "./dist/all.min.js",
    "./dist/global.min.js",
    "./dist/cjs/all.js"
  ],
  "jsdelivr": "dist/all.min.js",
  "unpkg": "dist/all.min.js",
  "files": [
    "src",
    "dist",
    "README.md",
    "ARCH.md",
    "LICENSE",
    "documentation",
    "examples"
  ],
  "peerDependencies": {
    "defuss-morph": "^0.1.1",
    "defuss-query": "^0.1.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "24.10.0",
    "c8": "10.1.3",
    "defuss-morph": "0.1.1",
    "defuss-query": "0.1.0",
    "esbuild": "0.25.12",
    "playwright": "1.58.2",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test:unit": "c8 --reporter=text --reporter=json-summary --reporter=lcov --include=dist/locale.js --include=dist/attributes.js node --test tests/core.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:package": "node scripts/package-tests.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "verify": "node scripts/verify.mjs",
    "check": "npm run build && npm run typecheck && npm test && npm run test:package && npm run verify",
    "serve": "node scripts/serve.mjs",
    "prepublishOnly": "npm run check"
  }
}
