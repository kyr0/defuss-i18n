{
  "name": "defuss-i18n",
  "version": "0.2.0",
  "description": "HTML-authored localization with component-owned DOM morphing, attribute translations and native Intl formatting.",
  "type": "module",
  "license": "MIT",
  "author": "Aron Homberg <info@aron-homberg.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyr0/defuss-i18n.git"
  },
  "homepage": "https://github.com/kyr0/defuss-i18n#readme",
  "bugs": {
    "url": "https://github.com/kyr0/defuss-i18n/issues"
  },
  "keywords": [
    "defuss",
    "i18n",
    "html",
    "morph",
    "localization",
    "typescript",
    "shadcn"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "default": "./dist/all.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/all.js",
    "./dist/all.min.js",
    "./dist/global.min.js"
  ],
  "jsdelivr": "dist/all.min.js",
  "unpkg": "dist/all.min.js",
  "files": [
    "src",
    "dist",
    "README.md",
    "ARCH.md",
    "LICENSE",
    "documentation",
    "examples"
  ],
  "peerDependencies": {
    "defuss-morph": "^0.1.1",
    "defuss-query": "^0.1.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "24.10.0",
    "c8": "10.1.3",
    "defuss-morph": "0.1.1",
    "defuss-query": "0.1.0",
    "esbuild": "0.25.12",
    "oxlint": "1.87.0",
    "pkgroll": "2.28.1",
    "playwright": "1.58.2",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "pkgroll --clean-dist --sourcemap '--packagejson=dist/{index,core,global}.{js,cjs,d.ts,d.cts}' && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "oxlint --deny-warnings && bun run typecheck",
    "test:unit": "c8 --exclude-after-remap --reporter=text --reporter=json-summary --reporter=lcov --include=src/locale.ts --include=src/attributes.ts node --test tests/core.test.mjs tests/docs.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:package": "node scripts/package-tests.mjs",
    "test": "bun run test:unit && bun run test:browser",
    "verify": "node scripts/verify.mjs",
    "check": "bun run build && bun run lint && bun run test && bun run test:package && bun run verify",
    "serve": "node scripts/serve.mjs",
    "prepublishOnly": "bun run check"
  }
}
